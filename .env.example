# Settings for the deck submission form (functions/api/submit-deck.js).
#
# Production: add these in Cloudflare Pages → your project → Settings →
# Variables and secrets. Mark BREVO_API_KEY and TURNSTILE_SECRET_KEY as secrets.
# Local development: copy this file to .dev.vars (Wrangler) or export the values
# in your shell before running `npm run preview`. Never commit real values.

# Brevo API key: Brevo → SMTP & API → API keys.
BREVO_API_KEY=

# ID of the Brevo contact list that collects deck submissions (a number).
BREVO_DEALFLOW_LIST_ID=

# Sender of both emails. Its domain must be authenticated in Brevo.
BREVO_SENDER_EMAIL=noreply@01.capital
BREVO_SENDER_NAME=01 Capital

# Inbox that receives each new submission. Founders' confirmations use it as the reply-to address.
DEALS_INBOX_EMAIL=deals@01.capital

# Cloudflare Turnstile secret key: Cloudflare → Turnstile → your widget.
# The matching site key is public and goes in src/data/site.json ("turnstileSiteKey").
TURNSTILE_SECRET_KEY=

# Local development only: skips the spam check when TURNSTILE_SECRET_KEY is empty.
# Never set this in production.
# ALLOW_MISSING_TURNSTILE=true
